# Optional absolute paths. Defaults point to this repository and its Python venv.
# EVAL_PROJECT_ROOT=/absolute/path/to/RAG_abitura
# EVAL_PYTHON=/absolute/path/to/RAG_abitura/.venv/bin/python
# EVAL_ANSWERS_DB=/absolute/path/to/answers.sqlite3

# Yandex API for single-question RAG answers (server only; also read from eval/.env).
# YANDEX_API_KEY=your-api-key
# YANDEX_CLOUD_FOLDER=your-folder-id
# Optional comma-separated model IDs offered by the new-question form.
# YANDEX_MODELS=gpt-oss-120b/latest,deepseek-v4-flash/latest
# EVAL_RAG_DATA_DIR=/absolute/path/to/RAG_data
