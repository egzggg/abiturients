# Never commit real credentials. Copy this file to .env and fill the values.
TELEGRAM_BOT_TOKEN=
GIGACHAT_CREDENTIALS=

# Safe defaults; override only when your environment requires it.
GIGACHAT_MODEL=GigaChat
GIGACHAT_VERIFY_SSL=true
QDRANT_HOST=localhost
QDRANT_PORT=6333
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_KNOWLEDGE_COLLECTION=knowledge_base
QDRANT_QUERY_COLLECTION=query_index
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DIMENSION=1024
RETRIEVAL_SEARCH_LIMIT=10
RETRIEVAL_RESULT_LIMIT=10
RETRIEVAL_MIN_KB_SCORE=0.78
RETRIEVAL_CQ_BOOST=1.05
LOG_DIR=logs
